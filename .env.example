PORT=3000
RATE_LIMIT_PREFIX=lifestyle:local:quota:v1

# Uncomment all three after configuring your identity provider.
# AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Uncomment both to enable shared provider quotas.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-redis-rest-token

# Configure only the integrations you need.
# LOGO_DEV_PUBLISHABLE_KEY=pk_replace-with-publishable-key
# USDA_API_KEY=replace-with-data-gov-key

# Configure all four required Plaid values together. Use sandbox first.
# PLAID_CLIENT_ID=replace-with-plaid-client-id
# PLAID_SECRET=replace-with-plaid-sandbox-secret
# PLAID_PRODUCTS=transactions
# PLAID_REDIRECT_URI=https://your-app.example.com/plaid/
# PLAID_ENV=sandbox
# PLAID_CLIENT_NAME=Lifestyle
# PLAID_COUNTRY_CODES=US