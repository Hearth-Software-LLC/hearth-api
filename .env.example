PORT=3000
RATE_LIMIT_PREFIX=hearth:local:quota:v1

# Uncomment all three after configuring your identity provider.
# AUTH_ISSUER=https://your-project.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Uncomment both to enable shared provider quotas.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-redis-rest-token

# Configure only the integrations you need.
# LOGO_DEV_PUBLISHABLE_KEY=pk_replace-with-publishable-key
# USDA_API_KEY=replace-with-data-gov-key

# Restaurant menus (FatSecret Platform, Premier or Premier Free: foods.search v5 needs the
# `premier` scope). Configure both together. FatSecret only answers requests from IP addresses
# registered in its developer console; see README › FatSecret.
# FATSECRET_CLIENT_ID=replace-with-fatsecret-client-id
# FATSECRET_CLIENT_SECRET=replace-with-fatsecret-client-secret
# FATSECRET_SCOPE=premier
# Hours a menu may stay in the shared cache (0-24, default 24). Check your plan's terms.
# RESTAURANT_CACHE_HOURS=24

# Configure the three required Plaid values together. Use sandbox first.
# PLAID_CLIENT_ID=replace-with-plaid-client-id
# PLAID_SECRET=replace-with-plaid-sandbox-secret
# PLAID_PRODUCTS=transactions
# Optional: only OAuth banks (Chase and others) need it. A registered HTTPS universal link.
# PLAID_REDIRECT_URI=https://your-app.example.com/plaid/
# PLAID_ENV=sandbox
# PLAID_CLIENT_NAME=Hearth
# PLAID_COUNTRY_CODES=US

# The Hearth Supabase project (BigTable data and bank connections). Configure both together.
# Project URL and a server-only secret key (Project Settings > API Keys > Secret keys).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace-with-secret-key
# 32-byte AES-256 key that seals Plaid access tokens; keep it out of the database. `openssl rand -base64 32`
# PLAID_TOKEN_KEY=replace-with-32-byte-base64-key

# BigTable (/v1/bigtable/*). Each feature answers an error until its key is set.
# ANTHROPIC_API_KEY=replace-with-anthropic-key        # AI meal plans, grocery lists, recipe import
# ANTHROPIC_MODEL=                                    # optional model override
# OPENAI_API_KEY=replace-with-openai-key              # recipe audio transcription
# GEMINI_API_KEY=replace-with-gemini-key              # generated recipe images
# GOOGLE_PLACES_API_KEY=replace-with-places-key       # dine-out place search
# REVENUECAT_WEBHOOK_SECRET=replace-with-shared-secret # Authorization header RevenueCat sends to /webhooks/revenuecat
# REVENUECAT_SECRET_API_KEY=sk_replace-with-revenuecat-secret
# REVENUECAT_PROJECT_ID=replace-with-revenuecat-project-id
# ENFORCE_ENTITLEMENTS=false # true: Plaid, restaurant menus and study groups need the app's plan or Hearth+ (402 otherwise)
# EXPO_ACCESS_TOKEN=replace-with-expo-token           # push notifications through Expo
# MAESTRO_RESET_TOKEN=                                # only for end-to-end test resets; leave unset in production

# Hearken study groups: direct Postgres (Supabase transaction pooler, port 6543)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# APNs auth key (.p8) for native push notifications
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=BH8R3BX5WF
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# HEARKEN_APNS_TOPIC=com.stephenwarren.hearken
# Vercel Cron's bearer token for /internal/* jobs
# CRON_SECRET=
