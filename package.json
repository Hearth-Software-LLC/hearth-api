{
  "name": "hearth-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "entitlements": "tsx --env-file=.env.hearth-production scripts/set-entitlements.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/zod-openapi": "1.6.3",
    "@supabase/supabase-js": "2.106.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "plaid": "48.0.0",
    "postgres": "3.4.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
